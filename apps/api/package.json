{
	"name": "api",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.json && cp src/db/schema.sql dist/db/schema.sql",
		"start": "node dist/index.js",
		"db": "tsx src/scripts/db-utils.ts",
		"db:init": "tsx src/scripts/db-utils.ts init",
		"db:wipe": "tsx src/scripts/db-utils.ts wipe",
		"db:seed": "tsx src/scripts/db-utils.ts seed",
		"db:export": "tsx src/scripts/db-utils.ts export",
		"db:reset": "tsx src/scripts/db-utils.ts reset"
	},
	"dependencies": {
		"better-sqlite3": "^12.3.0",
		"cors": "^2.8.5",
		"dotenv": "^17.2.2",
		"express": "^4.21.2"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/node": "^22.10.2",
		"tsx": "^4.20.5",
		"typescript": "^5.7.2"
	}
}
